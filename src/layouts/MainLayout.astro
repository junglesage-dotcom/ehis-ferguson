---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ehis Ferguson | Data, Research & Agribusiness Technology Consultant',
  description = 'Turning complex agricultural and educational data into scalable, evidence-based decisions.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Navigation />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      const revealElements = document.querySelectorAll('.reveal, .reveal-stagger');

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );

      revealElements.forEach((el) => observer.observe(el));
    </script>
        <div
      id="cookie-banner"
      class="fixed bottom-0 left-0 right-0 bg-navy-900 text-white p-4 hidden z-50"
    >
      <div class="max-w-content mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-white/80">
          This site uses minimal, privacy-first analytics and cookies for
          essential functionality only. See our
          <a href="/privacy" class="underline hover:text-emerald-400">Privacy Policy</a>.
        </p>
        <button
          id="cookie-accept"
          class="bg-emerald-500 hover:bg-emerald-700 text-white text-sm font-medium px-4 py-2 rounded whitespace-nowrap transition-colors"
        >
          Got it
        </button>
      </div>
    </div>

    <script>
      const banner = document.getElementById('cookie-banner');
      const acceptBtn = document.getElementById('cookie-accept');
      const consentKey = 'cookie-consent';

      if (banner && !localStorage.getItem(consentKey)) {
        banner.classList.remove('hidden');
      }

      acceptBtn?.addEventListener('click', () => {
        localStorage.setItem(consentKey, 'true');
        banner?.classList.add('hidden');
      });
    </script>
  </body>
</html>