---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Terms of Service | Ehis Ferguson">
  <section class="max-w-content mx-auto px-6 py-20">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-4xl font-display font-semibold text-navy-900">
        Terms of Service
      </h1>
      <p class="text-sm text-navy-900/50 mt-2">Last updated: August 2026</p>

      <div class="mt-10 flex flex-col gap-8 text-navy-900/80 text-sm leading-relaxed">
        <div class="border border-amber-400/40 bg-amber-400/10 rounded-lg p-4">
          <p class="text-navy-900">
            <strong>Placeholder:</strong> This page will be finalized once
            paid services (such as the academy) are live. Until then, this
            site offers informational and consulting-inquiry content only,
            governed by the terms below.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-navy-900 mb-2">
            Use of This Site
          </h2>
          <p>
            This website is provided for informational purposes, to showcase
            professional work, and to facilitate consulting inquiries. By
            using this site, you agree not to misuse its content, attempt to
            disrupt its operation, or use it for unlawful purposes.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-navy-900 mb-2">
            Intellectual Property
          </h2>
          <p>
            All content on this site — including case studies, research
            summaries, and written material — is the property of Ehis
            Ferguson unless otherwise credited, and may not be reproduced
            without permission.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-navy-900 mb-2">
            No Warranty
          </h2>
          <p>
            Content on this site is provided "as is" without warranties of
            any kind. Case study results reflect specific past engagements
            and are not guarantees of future outcomes.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-navy-900 mb-2">
            Future Services
          </h2>
          <p>
            Additional terms will apply to any paid services, courses, or
            academy offerings launched under this domain, and will be
            published here prior to their availability.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-navy-900 mb-2">
            Contact
          </h2>
          <p>
            Questions about these terms can be sent to
            <a href="mailto:ehis@ehisferguson.com" class="text-emerald-600 hover:text-emerald-700">
              ehis@ehisferguson.com
            </a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>