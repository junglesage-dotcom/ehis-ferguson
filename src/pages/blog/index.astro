---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<MainLayout title="Blog | Ehis Ferguson">
  <section class="max-w-content mx-auto px-6 py-20">
    <h1 class="text-4xl font-display font-semibold text-navy-900 text-center">
      Research Notes & Field Insights
    </h1>
    <p class="text-navy-900/70 text-center max-w-xl mx-auto mt-4">
      Analysis on data, agriculture, and education policy.
    </p>

    <div class="flex flex-col gap-6 mt-14 max-w-2xl mx-auto">
      {sortedPosts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="border border-navy-900/10 rounded-lg p-6 hover:border-emerald-500 transition-colors block"
        >
          <div class="flex items-center gap-3 text-xs text-navy-900/50 mb-2">
            <span>{post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            <span>·</span>
            <span>{post.data.readingTime}</span>
          </div>
          <h2 class="text-xl font-display font-semibold text-navy-900 mb-2">
            {post.data.title}
          </h2>
          <p class="text-sm text-navy-900/70">{post.data.description}</p>

          <div class="flex flex-wrap gap-2 mt-4">
            {post.data.tags.map((tag) => (
              <span class="text-xs bg-slate-50 border border-navy-900/10 px-2 py-1 rounded">
                {tag}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</MainLayout>