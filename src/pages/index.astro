---
import MainLayout from '../layouts/MainLayout.astro';

const stats = [
  { value: 120, suffix: '+', label: 'Extension Officers Trained' },
  { value: 8, suffix: '', label: 'Research Publications' },
  { value: 3, suffix: '', label: 'Agribusiness Systems Deployed' },
  { value: 5, suffix: '+', label: 'Years Data & Research Experience' },
];
const pillars = [
  {
    title: 'Data & Predictive Systems',
    description: 'Supply chain modeling, BI dashboards, geospatial analytics.',
  },
  {
    title: 'Research & Policy',
    description: 'M&E design, academic supervision, policy briefs.',
  },
  {
    title: 'Agribusiness & AgroTech',
    description: 'Precision agriculture, farm analytics, value chain optimization.',
  },
];
---

<MainLayout>

  <!-- HERO -->
  <section class="max-w-content mx-auto px-6 py-24 md:py-32 text-center">
  <p class="hero-eyebrow text-sm uppercase tracking-wide text-emerald-600 font-medium mb-4">
    Ehis Ferguson
  </p>
  <h1 class="hero-heading text-4xl md:text-6xl font-display font-semibold text-navy-900 leading-tight">
    Data Scientist · Research Consultant · Agribusiness Strategist
  </h1>
  <p class="hero-subhead text-lg text-navy-900/70 mt-6 max-w-2xl mx-auto">
    Turning agricultural and educational data into evidence-based decisions.
  </p>

  <div class="hero-ctas flex flex-col sm:flex-row gap-4 justify-center mt-10">
      <a
        href="/contact"
        class="bg-emerald-500 hover:bg-emerald-700 text-white font-medium px-6 py-3 rounded transition-colors"
      >
        Start a Project
      </a>
      <a
        href="/portfolio"
        class="border border-navy-900 text-navy-900 hover:bg-navy-900 hover:text-white font-medium px-6 py-3 rounded transition-colors"
      >
        View Case Studies
      </a>
    </div>
  </section>

  <!-- SOCIAL PROOF STATS -->
  <section class="bg-navy-900 py-16">
    <div class="max-w-content mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8 text-center reveal-stagger">
      {stats.map((stat) => (
  <div>
    <p class="text-3xl md:text-4xl font-display font-semibold text-emerald-400">
      <span class="stat-number" data-count={stat.value}>0</span>{stat.suffix}
    </p>
    <p class="text-sm text-white/70 mt-2">{stat.label}</p>
  </div>
  ))}
    </div>
  </section>

  <!-- EXPERTISE PREVIEW -->
  <section class="max-w-content mx-auto px-6 py-24">
    <h2 class="text-3xl font-display font-semibold text-navy-900 text-center mb-4">
      Core Expertise
    </h2>
    <p class="text-navy-900/70 text-center max-w-xl mx-auto mb-12">
      Three pillars, one goal: evidence-based decisions that scale.
    </p>

    <div class="grid md:grid-cols-3 gap-6 reveal-stagger">
      {pillars.map((pillar) => (
        <div class="border border-navy-900/10 rounded-lg p-6 hover:border-emerald-500 transition-colors">
          <h3 class="text-xl font-display font-semibold text-navy-900 mb-2">
            {pillar.title}
          </h3>
          <p class="text-navy-900/70 text-sm">{pillar.description}</p>
        </div>
      ))}
    </div>

    <div class="text-center mt-10">
      <a href="/expertise" class="text-emerald-600 hover:text-emerald-700 font-medium text-sm">
        View full expertise →
      </a>
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="bg-slate-100 py-20">
    <div class="max-w-content mx-auto px-6 text-center max-w-xl">
      <h2 class="text-2xl font-display font-semibold text-navy-900 mb-2">
        Research Notes & Field Insights
      </h2>
      <p class="text-navy-900/70 text-sm mb-6">
        Monthly analysis on data, agriculture, and education policy. No noise.
      </p>

      
        <form class="flex flex-col gap-3 justify-center">
  <div class="flex flex-col sm:flex-row gap-3 justify-center">
    <input
      type="email"
      placeholder="you@email.com"
      required
      class="border border-navy-900/20 rounded px-4 py-3 text-sm w-full sm:w-72 focus:outline-none focus:ring-2 focus:ring-emerald-500"
    />
    <button
      type="submit"
      class="bg-emerald-500 hover:bg-emerald-700 text-white font-medium px-6 py-3 rounded transition-colors whitespace-nowrap"
    >
      Subscribe
    </button>
  </div>
  <label class="flex items-center gap-2 justify-center text-xs text-navy-900/60">
    <input type="checkbox" required class="rounded" />
    I agree to receive research updates. See
    <a href="/privacy" class="text-emerald-600 hover:text-emerald-700">Privacy Policy</a>.
  </label>
</form>
    </div>
  </section>

</MainLayout>

<script>
  const counters = document.querySelectorAll('.stat-number');

  const counterObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const target = parseInt(el.getAttribute('data-count') || '0');
          const duration = 1000;
          const startTime = performance.now();

          function animate(currentTime: number) {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            el.textContent = Math.floor(progress * target).toString();
            if (progress < 1) requestAnimationFrame(animate);
            else el.textContent = target.toString();
          }

          requestAnimationFrame(animate);
          counterObserver.unobserve(el);
        }
      });
    },
    { threshold: 0.5 }
  );

  counters.forEach((el) => counterObserver.observe(el));
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script>
  window.addEventListener('load', () => {
    // @ts-ignore
    const gsap = window.gsap;
    if (!gsap) return;

    const tl = gsap.timeline();
    tl.from('.hero-eyebrow', { opacity: 0, y: 20, duration: 0.5 })
      .from('.hero-heading', { opacity: 0, y: 30, duration: 0.6 }, '-=0.2')
      .from('.hero-subhead', { opacity: 0, y: 20, duration: 0.5 }, '-=0.3')
      .from('.hero-ctas a', { opacity: 0, y: 15, duration: 0.4, stagger: 0.1 }, '-=0.2');
  });
</script>