---
import MainLayout from '../layouts/MainLayout.astro';

// Replace these placeholders with your real details
const whatsappNumber = '2349045520808'; // no + or leading zeros, country code first
const email = 'fergusonehis@gmail.com';
const telegramLink = 'https://t.me/JungleSage';
---

<MainLayout title="Contact | Ehis Ferguson">
  <section class="max-w-content mx-auto px-6 py-20">
    <h1 class="text-4xl font-display font-semibold text-navy-900 text-center">
      Start a Conversation
    </h1>
    <p class="text-navy-900/70 text-center max-w-xl mx-auto mt-4">
      Reach out directly, or send a message below.
    </p>

    <!-- Quick contact methods -->
    <div class="grid sm:grid-cols-3 gap-4 mt-12 max-w-3xl mx-auto">
      <a
        href={`https://wa.me/${whatsappNumber}`}
        target="_blank"
        rel="noopener noreferrer"
        class="border border-navy-900/10 rounded-lg p-5 text-center hover:border-emerald-500 transition-colors"
      >
        <p class="font-semibold text-navy-900">WhatsApp</p>
        <p class="text-sm text-navy-900/60 mt-1">Fastest response</p>
      </a>

      <a
        href={`mailto:${email}`}
        class="border border-navy-900/10 rounded-lg p-5 text-center hover:border-emerald-500 transition-colors"
      >
        <p class="font-semibold text-navy-900">Email</p>
        <p class="text-sm text-navy-900/60 mt-1">{email}</p>
      </a>

      <a
        href={telegramLink}
        target="_blank"
        rel="noopener noreferrer"
        class="border border-navy-900/10 rounded-lg p-5 text-center hover:border-emerald-500 transition-colors"
      >
        <p class="font-semibold text-navy-900">Telegram</p>
        <p class="text-sm text-navy-900/60 mt-1">Research updates</p>
      </a>
    </div>

    <!-- Contact form -->
    <form class="max-w-xl mx-auto mt-16 flex flex-col gap-5">
      <div>
        <label for="name" class="text-sm font-medium text-navy-900">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full border border-navy-900/20 rounded px-4 py-3 mt-1 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <div>
        <label for="email" class="text-sm font-medium text-navy-900">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full border border-navy-900/20 rounded px-4 py-3 mt-1 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <div>
        <label for="organization" class="text-sm font-medium text-navy-900">Organization</label>
        <input
          type="text"
          id="organization"
          name="organization"
          class="w-full border border-navy-900/20 rounded px-4 py-3 mt-1 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <div>
        <label for="project-type" class="text-sm font-medium text-navy-900">Project Type</label>
        <select
          id="project-type"
          name="project-type"
          class="w-full border border-navy-900/20 rounded px-4 py-3 mt-1 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
        >
          <option>Data & Predictive Systems</option>
          <option>Research & Policy</option>
          <option>Agribusiness & AgroTech</option>
          <option>Other</option>
        </select>
      </div>

      <div>
        <label for="message" class="text-sm font-medium text-navy-900">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="w-full border border-navy-900/20 rounded px-4 py-3 mt-1 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
        ></textarea>
      </div>

      <button
        type="submit"
        class="bg-emerald-500 hover:bg-emerald-700 text-white font-medium px-6 py-3 rounded transition-colors"
      >
        Send Message
      </button>
    </form>
  </section>
</MainLayout>