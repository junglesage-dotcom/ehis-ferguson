---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Privacy Policy | Ehis Ferguson">
  <section class="max-w-content mx-auto px-6 py-20">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-4xl font-display font-semibold text-navy-900">
        Privacy Policy
      </h1>
      <p class="text-sm text-navy-900/50 mt-2">Last updated: August 2026</p>

      <div class="mt-10 flex flex-col gap-8 text-navy-900/80 text-sm leading-relaxed">
        <div>
          <h2 class="text-xl font-display font-semibold text-navy-900 mb-2">
            What This Policy Covers
          </h2>
          <p>
            This policy explains what information is collected when you visit
            ehisferguson.com, why it's collected, and how it's used. This site
            does not use tracking cookies for advertising, and does not sell
            personal data to third parties.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-navy-900 mb-2">
            Information Collected
          </h2>
          <ul class="flex flex-col gap-2 list-disc list-inside">
            <li>
              <strong>Newsletter signup:</strong> Email address, collected via
              the newsletter form and stored with Kit (formerly ConvertKit),
              only if you choose to subscribe.
            </li>
            <li>
              <strong>Contact form:</strong> Name, email, organization, and
              message content, submitted when you use the contact form.
              Processed via Cloudflare Workers.
            </li>
            <li>
              <strong>Analytics:</strong> Anonymous, aggregate visit data via
              Cloudflare Web Analytics, which does not use cookies and does
              not track individual visitors.
            </li>
          </ul>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-navy-900 mb-2">
            How Information Is Used
          </h2>
          <p>
            Newsletter emails are used solely to send the research notes and
            field insights you signed up for. Contact form submissions are
            used only to respond to your inquiry. Neither is shared with
            third parties for marketing purposes.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-navy-900 mb-2">
            Your Rights
          </h2>
          <p>
            You can unsubscribe from the newsletter at any time using the
            link in any email. To request deletion of any data associated
            with your email address, contact
            <a href="mailto:ehis@ehisferguson.com" class="text-emerald-600 hover:text-emerald-700">
              ehis@ehisferguson.com
            </a>.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-navy-900 mb-2">
            Third-Party Services
          </h2>
          <p>
            This site uses Cloudflare (hosting, analytics, forms) and Kit
            (newsletter delivery). Each has its own privacy policy governing
            how they handle data on their platforms.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-display font-semibold text-navy-900 mb-2">
            Changes to This Policy
          </h2>
          <p>
            This policy may be updated as the site and its services evolve.
            Material changes will be reflected with an updated "last
            modified" date above.
          </p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>